{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "npm run build --workspace=@workspace/api-server && npm run build --workspace=@workspace/po-app",
    "build:backend": "npm run build --workspace=@workspace/api-server",
    "build:frontend": "npm run build --workspace=@workspace/po-app",    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  },
  "overrides": {
    "esbuild": "0.27.3"
  }
}
